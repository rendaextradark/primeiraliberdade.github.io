<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Primeira Liberdade — Do Zero à Monetização no TikTok</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #0a0b0e;
      --bg-card: #12141a;
      --border-card: #1f232e;
      --accent-green: #00ff87;
      --accent-hover: #00d971;
      --text-white: #ffffff;
      --text-gray: #a0aec0;
      --font-main: 'Inter', sans-serif;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: var(--font-main);
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-white);
      line-height: 1.6;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 20px;
    }

    header {
      padding: 50px 0 30px;
      text-align: center;
    }

    .badge {
      display: inline-block;
      background: rgba(0, 255, 135, 0.1);
      color: var(--accent-green);
      padding: 6px 16px;
      border-radius: 50px;
      font-weight: 700;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 20px;
      border: 1px solid rgba(0, 255, 135, 0.2);
    }

    h1 {
      font-size: 2.3rem;
      font-weight: 900;
      line-height: 1.25;
      margin-bottom: 18px;
    }

    h1 span {
      color: var(--accent-green);
    }

    .subheadline {
      font-size: 1.15rem;
      color: var(--text-gray);
      margin-bottom: 35px;
      max-width: 750px;
      margin-left: auto;
      margin-right: auto;
    }

    /* Video Frame */
    .video-wrapper {
      position: relative;
      padding-bottom: 56.25%; /* 16:9 */
      height: 0;
      overflow: hidden;
      border-radius: 14px;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6), 0 0 20px rgba(0, 255, 135, 0.15);
      border: 1px solid var(--border-card);
      margin-bottom: 35px;
    }

    .video-wrapper iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: none;
    }

    /* CTA Button */
    .cta-btn {
      display: inline-block;
      background: var(--accent-green);
      color: #000;
      font-size: 1.2rem;
      font-weight: 800;
      text-decoration: none;
      padding: 20px 40px;
      border-radius: 8px;
      box-shadow: 0 0 25px rgba(0, 255, 135, 0.4);
      transition: 0.3s ease;
      text-transform: uppercase;
      width: 100%;
      max-width: 480px;
      text-align: center;
    }

    .cta-btn:hover {
      background: var(--accent-hover);
      transform: translateY(-2px);
      box-shadow: 0 0 35px rgba(0, 255, 135, 0.6);
    }

    .cta-subtext {
      font-size: 0.85rem;
      color: var(--text-gray);
      margin-top: 10px;
    }

    /* Modulos */
    .section-title {
      text-align: center;
      font-size: 1.8rem;
      margin: 60px 0 25px;
      font-weight: 800;
    }

    .grid-modules {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 15px;
      margin-bottom: 50px;
    }

    .module-card {
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      padding: 20px;
      border-radius: 10px;
    }

    .module-tag {
      color: var(--accent-green);
      font-weight: 700;
      font-size: 0.8rem;
      text-transform: uppercase;
    }

    .module-title {
      font-weight: 700;
      font-size: 1.05rem;
      margin: 8px 0;
    }

    .module-desc {
      font-size: 0.9rem;
      color: var(--text-gray);
    }

    /* Bio / Autor */
    .bio-box {
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: 12px;
      padding: 30px;
      margin: 40px 0;
    }

    .bio-box h3 {
      font-size: 1.4rem;
      margin-bottom: 12px;
      color: var(--accent-green);
    }

    .bio-box p {
      color: var(--text-gray);
      font-size: 0.98rem;
      margin-bottom: 12px;
    }

    /* Oferta */
    .offer-box {
      background: linear-gradient(180deg, #161a22 0%, #0d0f14 100%);
      border: 2px solid var(--accent-green);
      border-radius: 14px;
      text-align: center;
      padding: 40px 20px;
      margin: 60px 0;
    }

    .price-strike {
      font-size: 1.1rem;
      color: #718096;
      text-decoration: line-through;
    }

    .price-tag {
      font-size: 3rem;
      font-weight: 900;
      color: var(--accent-green);
      margin: 10px 0 20px;
    }

    /* FAQ */
    .faq-section {
      margin: 50px 0;
    }

    .faq-item {
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: 8px;
      padding: 18px 22px;
      margin-bottom: 12px;
    }

    .faq-question {
      font-weight: 700;
      font-size: 1.05rem;
      margin-bottom: 6px;
    }

    .faq-answer {
      font-size: 0.95rem;
      color: var(--text-gray);
    }

    footer {
      border-top: 1px solid var(--border-card);
      padding: 35px 20px;
      text-align: center;
      font-size: 0.8rem;
      color: #636e72;
    }

    @media(max-width: 600px) {
      h1 { font-size: 1.7rem; }
      .cta-btn { font-size: 1.05rem; padding: 18px 24px; }
      .price-tag { font-size: 2.4rem; }
    }
  </style>
</head>
